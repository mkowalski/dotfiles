#!/usr/bin/bash
set -e

# Wait until at least one NetBird peer is connected, e.g. "Peers count: 1/10 Connected".
wait_for_netbird() {
    local timeout=60 elapsed=0 line
    while [ "${elapsed}" -lt "${timeout}" ]; do
        line=$(netbird status 2>/dev/null | grep -E '^Peers count:' || true)
        # Extract "X/Y" from the "Peers count: X/Y Connected" line.
        if [[ "${line}" =~ Peers\ count:\ ([0-9]+)/([0-9]+)\ Connected ]]; then
            local connected="${BASH_REMATCH[1]}" total="${BASH_REMATCH[2]}"
            if [ "${connected}" -gt 0 ]; then
                echo "NetBird connected (${connected}/${total} peers)."
                return 0
            fi
            echo "Waiting for peers to connect (${connected}/${total})..."
        else
            echo "Waiting for NetBird status..."
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    echo "Timed out waiting for NetBird peers to connect." >&2
    return 1
}

# Connect to the Red Hat network via NetBird.
# If already connected, try to refresh the SSO session without tearing
# down the tunnel; only fall back to a full "netbird up" if that fails.
if netbird status -C ready >/dev/null 2>&1; then
    echo "NetBird is already connected, extending SSO session..."
    if ! netbird login --extend; then
        echo "Extending session failed, bringing the connection up..."
        netbird up
    fi
else
    echo "Connecting to NetBird..."
    netbird up
fi

wait_for_netbird

# Restrict DNS so only Red Hat domains are resolved via the VPN tunnel;
# all other DNS requests keep using the default (non-VPN) resolvers.
# Discover the NetBird interface dynamically by matching the NetBird IP
# (falls back to "redhat0" if detection fails).
# The local machine's netbirdIp is the only one carrying a CIDR suffix
# (e.g. "100.91.103.235/15"); peer entries are bare host IPs.
NETBIRD_IP=$(netbird status --json 2>/dev/null | grep -oE '"netbirdIp":"[0-9.]+/[0-9]+"' | head -1 | cut -d'"' -f4 | cut -d/ -f1)
NETBIRD_IFACE=""
if [ -n "${NETBIRD_IP}" ]; then
    NETBIRD_IFACE=$(ip -o -4 addr show 2>/dev/null | grep " ${NETBIRD_IP}/" | awk '{print $2}')
fi
NETBIRD_IFACE="${NETBIRD_IFACE:-redhat0}"
echo "Configuring split DNS on ${NETBIRD_IFACE}..."
resolvectl status "${NETBIRD_IFACE}"
sudo resolvectl dns "${NETBIRD_IFACE}" 100.100.100.101 100.100.100.102 100.100.100.100
sudo resolvectl domain "${NETBIRD_IFACE}" '~redhat.com' '~red.ht' '~signalfx.com' \
    '~openshift.com' '~openshiftapps.com' '~devshift.net' '~redhat.corp'
sudo resolvectl default-route "${NETBIRD_IFACE}" false

# Additionally get the kerberos ticket after connection
KERBEROS_USERNAME="mkowalsk"
KERBEROS_REALM="IPA.REDHAT.COM"
GOPASS_KERBEROS="corporate/kerberos/${KERBEROS_USERNAME}"

echo $(gopass -f ${GOPASS_KERBEROS}) | kinit ${KERBEROS_USERNAME}@${KERBEROS_REALM}
