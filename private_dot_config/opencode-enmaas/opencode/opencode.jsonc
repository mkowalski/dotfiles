{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "/home/mkowalsk/.config/opencode-enmaas/opencode/plugins/enmaas-compat",
    "opencode-plugin-litellm@latest"
  ],
  "model": "openai/rits/zai-org/glm-5-3",
  "providers": {
    "enmaas": {
      "name": "EnMaaS",
      "env": ["ENMAAS_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.enmaas.devshift.net/v1"
      },
      "models": {
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3",
          "limit": { "context": 262144, "output": 65536 }
        }
      }
    },
    "openai": {
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" },
      "env": ["ENMAAS_KEY"]
    },
    "anthropic": {
      "settings": { "baseURL": "https://api.enmaas.devshift.net/v1" },
      "env": ["ENMAAS_KEY"]
    },
    "litellm": {
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "LiteLLM (Proxy)",
      "settings": {
        "baseURL": "https://llm.mkowalski.com/v1",
        "apiKey": "{env:LITELLM_API_KEY}"
        },
      "env": ["LITELLM_API_KEY"],
      "models": {
        "github_copilot/gpt-6.1-sol": {
          "package": "@opencode/ai/providers/openai/responses",
          "limit": { "context": 922000, "output": 128000 },
          "settings": { "reasoningSummary": "auto" },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "github_copilot/gpt-6-astra": {
          "package": "@opencode/ai/providers/openai/responses",
          "limit": { "context": 1050000, "output": 128000 },
          "settings": { "reasoningSummary": "auto" },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        },
        "github_copilot/gpt-5.6-sol": {
          "package": "@opencode/ai/providers/openai/responses",
          "limit": { "context": 922000, "output": 128000 },
          "settings": { "reasoningSummary": "auto" },
          "variants": [
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    }
  }
}
