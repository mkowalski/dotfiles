{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "opencode-plugin-litellm@1.5.0",
    "{{ .chezmoi.homeDir }}/.config/opencode/plugins/litellm-anthropic-variants"
  ],
{{- if eq .chezmoi.hostname "mkowalsk-x1c-rht" }}
  "mcp": {
    "servers": {
      "redhat-docs": {
        "type": "remote",
        "url": "https://docs-mcp.api.redhat.com/mcp"
      }
    }
  },
{{- end }}
  "disabled_providers": ["opencode"],
  "providers": {
    {{ template "opencode-litellm-provider.jsonc" . }}
  }
}
